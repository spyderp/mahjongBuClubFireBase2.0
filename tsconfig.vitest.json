{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "types": ["node", "vitest/globals"],
    "composite": true,
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.vitest.tsbuildinfo"
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "src/__tests__/**/*", "src/test-utils/**/*"],
  "exclude": ["node_modules", "dist"]
}
